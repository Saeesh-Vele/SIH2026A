{
  "schemaVersion": 1,
  "description": "Aurora assistant: the ONLY UI actions the assistant may trigger. The backend turns these into the LLM's tool schemas and validates every tool call against them (simulator/assistant.py); the frontend validates again and executes them (src/assistant/actions.js). Nothing outside this list can run. stateChanging actions need a confirmation and follow the public-demo / ADMIN_TOKEN rules of the routes they call.",
  "modules": [
    "overview",
    "environmental",
    "infrastructure",
    "energy",
    "logistics",
    "remote",
    "simulation",
    "ai",
    "reports",
    "admin"
  ],
  "whatIfScenarios": [
    "extreme_cold",
    "blizzard",
    "gen_failure",
    "battery_failure",
    "fuel_leak",
    "comms_outage",
    "resupply_delay"
  ],
  "stories": [
    "blizzard",
    "generator",
    "fuel",
    "linkloss"
  ],
  "demoScenarios": [
    "generator_failure",
    "heating_failure",
    "blizzard",
    "water_crisis",
    "co2_spike",
    "link_loss"
  ],
  "alertTabs": [
    "active",
    "acknowledged",
    "history"
  ],
  "actions": {
    "navigate": {
      "description": "Open a page of the dashboard, optionally at a station.",
      "args": {
        "module": {
          "type": "enum",
          "of": "modules",
          "required": true
        },
        "station": {
          "type": "station"
        }
      },
      "stateChanging": false
    },
    "switchStation": {
      "description": "Switch the dashboard to another station.",
      "args": {
        "station": {
          "type": "station",
          "required": true
        }
      },
      "stateChanging": false
    },
    "openBuildingPanel": {
      "description": "Open the details panel of one building (component) at the current station.",
      "args": {
        "id": {
          "type": "building",
          "required": true
        }
      },
      "stateChanging": false
    },
    "highlightComponents": {
      "description": "Highlight one or more buildings (components) on the dashboard.",
      "args": {
        "ids": {
          "type": "buildingList",
          "required": true
        }
      },
      "stateChanging": false
    },
    "showDependencyChain": {
      "description": "Show what depends on a building: highlight it and everything downstream of it in the dependency graph.",
      "args": {
        "id": {
          "type": "building",
          "required": true
        }
      },
      "stateChanging": false
    },
    "openAlertCentre": {
      "description": "Open the alert centre on one tab.",
      "args": {
        "tab": {
          "type": "enum",
          "of": "alertTabs"
        }
      },
      "stateChanging": false
    },
    "runWhatIf": {
      "description": "Run a read-only, rule-based what-if scenario against the current snapshot (changes nothing) and show the result.",
      "args": {
        "scenario": {
          "type": "enum",
          "of": "whatIfScenarios",
          "required": true
        },
        "intensity": {
          "type": "number",
          "min": 0.5,
          "max": 2.0
        }
      },
      "stateChanging": false
    },
    "startStory": {
      "description": "Start a guided story. Stories that run a demo scenario change what every visitor sees, so they need a confirmation.",
      "args": {
        "id": {
          "type": "enum",
          "of": "stories",
          "required": true
        }
      },
      "stateChanging": true
    },
    "triggerDemoScenario": {
      "description": "Start a predefined demo fault scenario at a station (shared with every visitor, resets itself). Needs a confirmation.",
      "args": {
        "id": {
          "type": "enum",
          "of": "demoScenarios",
          "required": true
        },
        "station": {
          "type": "station"
        }
      },
      "stateChanging": true
    },
    "openAiDiagnostics": {
      "description": "Open the AI diagnostics page (anomaly detector, decision engine, forecasts).",
      "args": {
        "station": {
          "type": "station"
        }
      },
      "stateChanging": false
    },
    "stopSpeaking": {
      "description": "Stop the current spoken reply.",
      "args": {},
      "stateChanging": false
    },
    "mute": {
      "description": "Turn Aurora's voice off.",
      "args": {},
      "stateChanging": false
    }
  },
