# ═══════════════════════════════════════════════════════════════
# Aurora — Environment Variables (single source: the ROOT .env)
#
#   cp .env.example .env      # then edit values
#
# NEVER commit .env — it is ignored by .gitignore.
# Python services load this file via simulator/config.py (python-dotenv);
# real environment variables always override .env values.
# The frontend (Vite) reads only VITE_* variables, at build/dev time.
# Every variable is optional; the defaults shown work for local dev.
# simulator/.env is NOT read any more (services log a warning if it exists):
# move any values from it (e.g. GROQ_API_KEY) into this root .env.
# ═══════════════════════════════════════════════════════════════

# ── Python services: network ───────────────────────────────────
# Interface to bind. Keep 127.0.0.1 locally; containers set 0.0.0.0.
HOST=127.0.0.1
# Port of simulator/unified_backend.py (the single public backend).
API_PORT=8080
# Port of simulator/simulator.py (internal control API).
SIM_PORT=8001
# Where simulator.py POSTs telemetry (base URL, no path).
BACKEND_URL=http://localhost:8080
# Base URL of the internal simulator API (for backend→simulator calls).
SIMULATOR_URL=http://localhost:8001
# Comma-separated browser origins allowed by CORS and /ws/station.
# "*" is NOT allowed and is ignored if present.
#
# DOCKER: this is the ONE variable you must change for a real server. nginx forwards
# the browser's Origin header, and the backend enforces this list on WebSocket
# upgrades (CORSMiddleware does not cover WS). Set it to how people actually reach
# the UI, e.g. ALLOWED_ORIGINS=http://203.0.113.10 or https://aurora.example.org
# (several, comma-separated, are fine). If it is wrong the UI loads but silently
# falls back to browser-demo mode and the backend logs "WS rejected: disallowed origin".
ALLOWED_ORIGINS=http://localhost:5173

# ── Python services: data & simulation ─────────────────────────
# SQLite observations DB. Relative paths resolve against simulator/.
DB_PATH=data_store/antarctic_observations.db
# "reanalysis" (ERA5 weather → physics model) or "simulation" (random walk).
AURORA_MODE=reanalysis
# Replay speed multiplier (120 = 2 simulated hours per real minute).
AURORA_SPEED=120
# ERA5 replay start date (YYYY-MM-DD). Leave EMPTY to use the latest date
# available in simulator/weather_cache/ (no network needed at startup).
AURORA_DATE=
# Python log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# ── Unified backend runtime ────────────────────────────────────
# A simulator batch newer than this many seconds makes the simulator the
# telemetry source; otherwise the backend's physics fallback is used.
SIM_BATCH_FRESH_S=10
# Rolling in-memory history kept per sensor (points). 900 × 2 s = 30 min, the window
# GET /api/history serves to the charts and the 15-min fuel-burn average.
HISTORY_MAX_POINTS=900
# Background tick (seconds) — the only thing that advances physics state.
TICK_INTERVAL_S=2.0
# Alerts auto-resolve after this many consecutive normal ticks (hysteresis).
ALERT_RESOLVE_TICKS=3
# Simulated remote commands move "queued (simulated)" → "acknowledged (simulated)"
# after this many seconds (nothing is ever executed — there is no station link).
REMOTE_ACK_DELAY_S=5

# ── start.sh / start.ps1 (read from the SHELL environment, not this file) ──
#   AURORA_PYTHON=/path/to/python   default: .venv/bin/python (.venv\Scripts\python.exe)
#   VITE_PORT=5173                  Vite dev server port
#   HEALTH_TIMEOUT_S=60             how long to wait for /api/health

# ── Python services: LLM explanation layer (optional) ──────────
# Server-side only; never exposed to the browser. If empty, explain
# endpoints return an honest offline summary ("LLM unavailable").
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Frontend (Vite): backend addresses ─────────────────────────
# Absolute URLs for local dev, or relative paths behind a reverse proxy:
#   VITE_API_URL=/api            (or empty for same-origin; "/api" is appended if missing)
#   VITE_WS_URL=/ws/station      (ws:// or wss:// derived from the page URL)
# The browser only talks to the unified backend; the simulator (:8001) is internal.
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws/station

# ── Production hardening ────────────────────────────────────────
# APP_ENV=production makes the backend REFUSE TO START if ADMIN_TOKEN is empty or
# ALLOWED_ORIGINS still mentions localhost. Leave it at "development" locally.
APP_ENV=development
# Write protection. When set, every state-changing endpoint requires the header
#   X-Admin-Token: <ADMIN_TOKEN>
# and returns 401 without it: thresholds, logistics edits, alert acknowledge, remote
# dispatch, simulator inject/reset/mode, NCPOR ingest and telemetry ingest. Reads and the
# WebSocket stay public, so the dashboard is fully viewable without a token, and the UI
# offers an "Operator login" in the top bar (held in memory only, never stored).
# Unset = no protection: fine locally, never on a public host.
#   generate one with:  openssl rand -hex 32
ADMIN_TOKEN=
# Cap on outbound Groq calls per rolling hour for the whole process. Past the cap the
# explain endpoints return the deterministic offline summary instead of calling Groq.
GROQ_MAX_CALLS_PER_HOUR=40
# Rolling 24 h cap (Groq free tier: 200k tokens/day; an assistant explanation is ~1.8k
# tokens, so 100 a day fits), and how long an identical explanation request reuses the
# previous answer.
GROQ_MAX_CALLS_PER_DAY=100
EXPLAIN_CACHE_S=120
# Aurora assistant: a small, fast model routes free-form requests to the whitelisted UI
# actions (tool calling); its answers use GROQ_MODEL and the caps above. The router has
# its own caps (Groq meters each model separately; gpt-oss-20b free tier: 1,000 req/day,
# 200k tokens/day). Most commands never reach it: deterministic parsers handle them.
GROQ_ROUTER_MODEL=openai/gpt-oss-20b
GROQ_ROUTER_MAX_CALLS_PER_HOUR=30
GROQ_ROUTER_MAX_CALLS_PER_DAY=120

# ── Docker (docker-compose.yml) ─────────────────────────────────
# Only these are read by compose itself; everything above is passed to the services.
# Required for a non-localhost deployment: ALLOWED_ORIGINS (see above).
# Everything here is optional.
#
# Host port the UI is published on. 80 needs root or CAP_NET_BIND_SERVICE; use e.g.
# 8088 behind another proxy.
HTTP_PORT=80
# Build the simulator image with the optional Chronos extras (torch, CPU-only).
# Adds ~2.5 GB to the image and needs SIMULATOR_MEMORY_LIMIT=3g and a 4 GB+ host.
WITH_ML=false
# Memory ceiling for the simulator container. 768M is ample without ML (measured
# idle RSS ~410 MB); use 3g with WITH_ML=true.
SIMULATOR_MEMORY_LIMIT=768M
# Only for the HTTPS overlay (docker-compose.https.yml): the domain Caddy requests a
# Let's Encrypt certificate for, and the address in the ACME account.
DOMAIN=
ACME_EMAIL=

# ── Frontend (Vite): Firebase (DISABLED by default) ────────────
# Initialises only when VITE_ENABLE_FIREBASE is exactly "true" AND the
# values below are set. database.rules.json denies all reads/writes.
# Vite inlines any referenced VITE_* value into the bundle, so leave
# these empty while Firebase is disabled.
VITE_ENABLE_FIREBASE=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Judge mode (public deployment) ───────────────────────────
# true: anonymous visitors get a private 1-hour sandbox for every write (thresholds,
# ledger, acknowledgements, remote commands) and may run the predefined demo scenarios
# (one per station at a time, auto-reset after PUBLIC_DEMO_DURATION_S, PUBLIC_DEMO_COOLDOWN_S
# per IP). The shared state still needs ADMIN_TOKEN. Set it to true in production.
VISITOR_SANDBOX=false
# true: anonymous visitors may run (and reset) the predefined demo scenarios.
PUBLIC_DEMO=false
SANDBOX_TTL_S=3600
SANDBOX_MAX_SESSIONS=500
SANDBOX_WRITES_PER_MIN=30
PUBLIC_DEMO_DURATION_S=120
PUBLIC_DEMO_COOLDOWN_S=60

# Simulated satellite link: readings held per station while the link is down (2 h at 2 s).
LINK_BUFFER_MAX_READINGS=3600

# NCPOR AWS live pages: automatic sync interval in minutes (0 = off; "Sync now" still works),
# and the longest back-off after repeated failures.
NCPOR_SYNC_INTERVAL_MIN=30
NCPOR_SYNC_MAX_BACKOFF_MIN=240
